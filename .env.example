# ============================================================================
# Nexora Cloud Platform — Environment Variables (Production)
# ============================================================================

# Core
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=file:/app/data/nexora.db

# Realtime WebSocket Service
REALTIME_PORT=3003
REALTIME_URL=http://realtime:3003
# Comma-separated list of allowed CORS origins for the realtime service
ALLOWED_ORIGINS=http://localhost:3000

# Authentication (NextAuth.js)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Encryption key for secrets (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-64-hex-char-string

# Docker Compose
DASHBOARD_PORT=3000
DASHBOARD_DOMAIN=localhost
REALTIME_DOMAIN=localhost

# Optional Integrations
# STRIPE_SECRET_KEY=sk_live_xxx
# OPENAI_API_KEY=sk-xxx
# SENTRY_DSN=https://xxx@sentry.io/1
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Prometheus Metrics (optional — /api/metrics endpoint)
# METRICS_ENABLED=true

# VAPID Keys for Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=BGxxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_SUBJECT=mailto:admin@nexora.app

# GitHub OAuth (for CI/CD integrations)
# GITHUB_CLIENT_ID=Iv1.xxx
# GITHUB_CLIENT_SECRET=xxx
