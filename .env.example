# ============================================================================
# Nexora Cloud Platform — Environment Variables Example
# ============================================================================
# Copy this file to `.env` for local development or `.env.production` for
# production deployment, then fill in your values.
#
#   cp .env.example .env
#   cp .env.example .env.production
# ============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ----------------------------------------------------------------------------
# Database (SQLite by default; switch to PostgreSQL/MySQL for production scale)
# ----------------------------------------------------------------------------
# SQLite (default — stored in /app/data/nexora.db)
DATABASE_URL=file:/app/data/nexora.db

# PostgreSQL (recommended for production multi-instance)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexora?schema=public

# MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/nexora

# ----------------------------------------------------------------------------
# Realtime WebSocket Service
# ----------------------------------------------------------------------------
REALTIME_PORT=3003
# URL used by the dashboard to connect to the realtime service
# (use service name from docker-compose when containerized)
REALTIME_URL=http://realtime:3003

# ----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Docker Compose
# ----------------------------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_DOMAIN=localhost
REALTIME_DOMAIN=localhost

# ----------------------------------------------------------------------------
# Optional Integrations (uncomment + fill to enable)
# ----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# SENTRY_DSN=https://xxx@sentry.io/1
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# SENDGRID_API_KEY=SG.xxx
# AWS_ACCESS_KEY_ID=AKIAxxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=nexora-backups

# ----------------------------------------------------------------------------
# VAPID Keys for Web Push (generate with: npx web-push generate-vapid-keys)
# ----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=BGxxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_SUBJECT=mailto:admin@nexora.app

# ----------------------------------------------------------------------------
# GitHub OAuth (for CI/CD integrations)
# ----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=Iv1.xxx
# GITHUB_CLIENT_SECRET=xxx
# GITHUB_WEBHOOK_SECRET=xxx
