# ============================================================================
# Nexora Cloud Platform — .gitignore
# ============================================================================
# IMPORTANT: Never commit .env files containing secrets!
# ============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
bun.lockb

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Production
*.tsbuildinfo
next-env.d.ts

# Environment files (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Keep the example committed
!.env.example

# Database files (runtime data)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
.zscripts/*.log
mini-services/**/node_modules
mini-services/**/bun.lock
mini-services/**/.env

# Runtime data
.pids
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/
*.lcov

# IDE & editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-workspace
*.sublime-project

# Docker (local volumes — should not be committed)
docker/data/
*.tar.gz

# OS
.DS_Store
Thumbs.db

# Test
test-results/
playwright-report/
playwright/.cache/

# Misc
.claude/
.bun/
upload/
download/

# Keep these committed (do NOT ignore)
!.github/
!Dockerfile
!Dockerfile.*
!docker-compose*.yml
!.dockerignore
!README.md
!LICENSE
!CONTRIBUTING.md
skills/EXCLUDE
